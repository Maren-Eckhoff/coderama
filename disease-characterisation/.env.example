# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=kaggle-sandbox-686020
GOOGLE_CLOUD_LOCATION=global
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=google_cloud_trace

# Optional: Set to true locally to export all FastAPI/Playground spans, metrics,
# and logs to Google Cloud Telemetry (enabled automatically on Agent Runtime):
# GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Optional: Set to false to omit raw user prompts and LLM completion text from
# OpenTelemetry spans for strict PII/PHI privacy in shared GCP projects:
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Alternatively, for Gemini API via Google AI Studio,
# comment out the lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
